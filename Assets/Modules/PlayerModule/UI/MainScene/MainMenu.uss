/* Фоновый контейнер на весь экран */
.screen-bg {
    flex-grow: 1;
    background-color: #080808;
    justify-content: center; /* Центровка по вертикали */
    align-items: center;     /* Центровка по горизонтали */
}

/* Наклон для главного меню */
.tilted-container {
    rotate: -5deg;
}

.menu-btn {
    flex-direction: row;
    width: 400px;
    height: 110px;
    margin-bottom: 15px;
    padding: 0;
    border-width: 0;
    opacity: 0.7;
    transition: scale 0.2s, opacity 0.2s, background-color 0.2s;
}

.menu-btn:hover {
    scale: 1.05;
    opacity: 1;
}

/* Цвета как на картинке */
.bg-green { background-color: rgba(46, 125, 50, 0.8); }
.bg-blue { background-color: rgba(55, 71, 79, 0.8); }
.bg-red { background-color: rgba(183, 28, 28, 0.8); }

.btn-icon {
    width: 100px;
    height: 100%;
    /* Сюда вставь иконку через background-image */
    justify-content: center;
    align-items: center;
}

.divider {
    width: 2px;
    height: 80%;
    background-color: rgba(255, 255, 255, 0.2);
    align-self: center;
}

.text-group {
    padding-left: 20px;
    justify-content: center;
}

.btn-title {
    color: white;
    font-size: 35px;
    -unity-font-style: bold;
}

.btn-subtitle {
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
}

/* Настройки (без наклона) */
.options-container {
    position: absolute;
    top: 10%;
    left: 10%;
    width: 80%;
    height: 80%;
    background-color: #121212;
    padding: 40px;
}

.footer-btn {
    width: 200px;
    height: 60px;
    background-color: #2c2c2c;
    color: white;
    font-size: 20px;
    margin-right: 15px;
    border-width: 0;
}

.options-container {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: #050505; /* Глубокий черный фон */
    padding: 60px 100px;
}

.rebind-scroll {
    flex-grow: 1;
    margin-top: 20px;
}

/* Строка внутри списка */
.rebind-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    background-color: rgba(255, 255, 255, 0.03);
    margin-bottom: 5px;
    /* Гарантируем, что строка не шире списка */
    width: 100%;
}

.rebind-row:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.rebind-label {
    color: #DDDDDD;
    font-size: 20px;
    -unity-font-style: bold;
    text-transform: uppercase;
}

/* Кнопка с клавишей (справа) */
.rebind-button {
    width: 250px;
    height: 45px;
    background-color: #222222;
    border-width: 1px;
    border-color: #444444;
    color: white;
    font-size: 18px;
    border-radius: 4px;
    transition: border-color 0.2s, background-color 0.2s;
}

.rebind-button:hover {
    border-color: #888888;
    background-color: #333333;
}

/* Заголовок группы (например, COMBAT) */
.group-header {
    color: #777777;
    font-size: 14px;
    margin-top: 20px;
    margin-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
    -unity-font-style: bold;
}

/* Окно настроек */
.options-container {
    width: 85%;  /* Занимает 85% ширины экрана */
    height: 85%; /* Занимает 85% высоты экрана */
    
    background-color: #050505;
    padding: 40px;
    border-width: 1px;
    border-color: #222;
    
    /* Важно для внутренней компоновки */
    flex-direction: column;
    justify-content: space-between; 
}

/* Список команд */
.rebind-scroll {
    flex-grow: 1;
    /* Ограничиваем список, чтобы он не выталкивал футер */
    margin-bottom: 20px;
    padding-right: 15px;
}

/* Футер с кнопками */
.options-footer {
    flex-direction: row;
    flex-shrink: 0; /* Запрещаем сжимать футер */
    height: 80px;
    align-items: center;
    border-top-width: 1px;
    border-top-color: #333;
    padding-top: 20px;
}

.footer-btn {
    width: 180px;
    height: 50px;
    margin-right: 20px;
    background-color: #1a1a1a;
    color: white;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: #333;
}

/* Кнопка ввода (справа в строке) */
.rebind-button {
    width: 200px;
    height: 40px;
    background-color: #121212;
    border-width: 1px;
    border-color: #444;
    color: white;
}

.footer-btn:hover {
    background-color: #333;
    border-color: #555;
}