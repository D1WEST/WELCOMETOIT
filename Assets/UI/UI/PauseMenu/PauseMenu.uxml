<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="overlay" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.7); justify-content: center; align-items: center;">
        
        <ui:VisualElement class="boss-style-box" style="width: 400px; padding: 30px;">
            <ui:Label text="ПАУЗА" style="color: white; -unity-font-style: bold; font-size: 32px; -unity-text-align: middle-center; margin-bottom: 30px; letter-spacing: 5px;" />

            <ui:Button name="btn-resume" text="ПРОДОЛЖИТЬ" class="menu-button" style="margin-bottom: 15px; height: 50px; font-size: 20px;" />
            <ui:Button name="btn-restart" text="НАЧАТЬ СМЕНУ ЗАНОВО" class="menu-button" style="margin-bottom: 15px; height: 50px; font-size: 20px;" />
            <ui:Button name="btn-main-menu" text="ВЫЙТИ В МЕНЮ" class="menu-button" style="height: 50px; font-size: 20px; background-color: rgba(180, 50, 50, 0.8);" />
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>