/* --- БАЗОВЫЕ СТИЛИ (ФОН) --- */
.screen-bg {
    flex-grow: 1;
    background-color: transparent; /* Сделал прозрачным, чтобы было видно видео на фоне */
    justify-content: center;
    padding-left: 15%; /* Сдвигаем главное меню чуть вправо от края */
}

/* ========================================== */
/* --- НОВОЕ ГЛАВНОЕ МЕНЮ --- */
/* ========================================== */

.menu-container {
    width: 600px;
}

/* ЗАГОЛОВОК */
.header-block {
    margin-bottom: 40px;
}

.header-title {
    font-size: 60px;
    color: rgb(255, 255, 255);
    -unity-font-style: italic;
    -unity-font-weight: bold;
    letter-spacing: -2px;
    text-shadow: 0px 0px 10px rgba(255, 255, 255, 0.7);
    margin: 0; padding: 0;
}

.header-line {
    height: 2px;
    background-color: rgba(255, 255, 255, 0.6);
    margin-top: 5px; margin-bottom: 5px;
    width: 400px;
}

.header-subtitle {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.7);
    -unity-font-style: italic;
    margin: 0; padding: 0; padding-left: 5px;
}

/* КНОПКИ */
.buttons-block {
    margin-left: 20px;
}

.button-wrapper {
    flex-direction: row;
    align-items: center;
    margin-bottom: 15px;
}

.pointer-icon {
    font-size: 24px;
    color: white;
    margin-right: 10px;
    opacity: 0;
    transition-duration: 0.2s;
}

.menu-button {
    font-size: 28px;
    color: rgba(255, 255, 255, 0.6);
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    padding: 5px 15px; margin: 0;
    transition-duration: 0.2s;
}

.button-wrapper:hover .pointer-icon {
    opacity: 1;
}

.button-wrapper:hover .menu-button {
    color: rgb(255, 255, 255);
    border-color: rgba(255, 255, 255, 0.8);
    text-shadow: 0px 0px 5px rgba(255, 255, 255, 0.5);
}

/* ========================================== */
/* --- ВАШИ СТИЛИ НАСТРОЕК (БЕЗ ИЗМЕНЕНИЙ) ---*/
/* ========================================== */

.options-container {
    position: absolute;
    width: 85%; height: 85%;
    top: 7.5%; left: 7.5%; /* Центрирование */
    background-color: #050505;
    padding: 40px;
    border-width: 1px; border-color: #222;
    flex-direction: column; justify-content: space-between; 
}

.rebind-scroll {
    flex-grow: 1;
    margin-bottom: 20px;
    padding-right: 15px;
}

.rebind-row {
    flex-direction: row; justify-content: space-between; align-items: center;
    padding: 10px 20px;
    background-color: rgba(255, 255, 255, 0.03);
    margin-bottom: 5px; width: 100%;
}

.rebind-row:hover { background-color: rgba(255, 255, 255, 0.1); }

.rebind-label {
    color: #DDDDDD; font-size: 20px; -unity-font-style: bold; text-transform: uppercase;
}

.rebind-button {
    width: 200px; height: 40px;
    background-color: #121212; border-width: 1px; border-color: #444; color: white;
    transition: border-color 0.2s, background-color 0.2s;
}

.rebind-button:hover { border-color: #888888; background-color: #333333; }

.group-header {
    color: #777777; font-size: 14px; margin-top: 20px; margin-bottom: 5px;
    border-bottom-width: 1px; border-bottom-color: #333333; -unity-font-style: bold;
}

.options-footer {
    flex-direction: row; flex-shrink: 0; height: 80px; align-items: center;
    border-top-width: 1px; border-top-color: #333; padding-top: 20px;
}

.footer-btn {
    width: 180px; height: 50px; margin-right: 20px;
    background-color: #1a1a1a; color: white; -unity-font-style: bold;
    border-width: 1px; border-color: #333;
}

.footer-btn:hover { background-color: #333; border-color: #555; }