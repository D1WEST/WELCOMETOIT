<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- УБЕДИТЕСЬ, ЧТО ЗДЕСЬ ПРАВИЛЬНЫЙ ПУТЬ К ВАШЕМУ ФАЙЛУ СТИЛЕЙ .uss -->
    <Style src="MainMenu.uss"/> 
    
    <ui:VisualElement name="screen-bg" class="screen-bg">
        
        <!-- НОВОЕ ГЛАВНОЕ МЕНЮ -->
        <ui:VisualElement name="main-menu" class="menu-container">
            
            <!-- Заголовки -->
            <ui:VisualElement class="header-block">
                <ui:Label text="Welcome to IT" class="header-title" />
                <ui:VisualElement class="header-line" />
                <ui:Label text="by ScainetTeam" class="header-subtitle" />
            </ui:VisualElement>

            <!-- Кнопки со стрелочками -->
            <ui:VisualElement class="buttons-block">
                <ui:VisualElement class="button-wrapper">
                    <ui:Label text="▶" class="pointer-icon" />
                    <ui:Button name="btn-play" text="ИГРАТЬ" class="menu-button" />
                </ui:VisualElement>

                <ui:VisualElement class="button-wrapper">
                    <ui:Label text="▶" class="pointer-icon" />
                    <ui:Button name="btn-options" text="НАСТРОЙКИ" class="menu-button" />
                </ui:VisualElement>

                <ui:VisualElement class="button-wrapper">
                    <ui:Label text="▶" class="pointer-icon" />
                    <ui:Button name="btn-exit" text="ВЫЙТИ ИЗ ИГРЫ" class="menu-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            
        </ui:VisualElement>

        <!-- ВАШЕ МЕНЮ НАСТРОЕК (Осталось без изменений, изначально скрыто) -->
        <ui:VisualElement name="options-menu" class="options-container" style="display: none;">
            <ui:Label text="SETTINGS" class="options-header" style="color: white; font-size: 30px; -unity-font-style: bold; margin-bottom: 20px;" />
            <ui:ScrollView name="rebind-list" class="rebind-scroll"/>
            <ui:VisualElement class="options-footer">
                <ui:Button name="btn-save" text="SAVE" class="footer-btn"/>
                <ui:Button name="btn-reset" text="RESET" class="footer-btn"/>
                <ui:Button name="btn-back" text="BACK" class="footer-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>