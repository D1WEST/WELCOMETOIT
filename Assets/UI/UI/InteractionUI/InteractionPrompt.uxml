<ui:UXML xmlns:ui="UnityEngine.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ui:VisualElement name="prompt-container" picking-mode="Ignore" style="position: absolute; left: 0; top: 0;">
        <ui:VisualElement style="flex-direction: row; background-color: rgba(0, 0, 0, 0.8); padding: 6px 12px; border-radius: 4px; border-width: 1px; border-color: rgba(255, 255, 255, 0.5); align-items: center;">
            <ui:Label name="key-label" text="[E]" style="color: rgb(255, 221, 0); -unity-font-style: bold; margin-right: 8px; font-size: 18px;" />
            <ui:Label name="prompt-label" text="Взаимодействовать" style="color: white; font-size: 16px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>