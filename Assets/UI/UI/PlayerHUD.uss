.hud-root {
    position: absolute;
    bottom: 50px;
    left: 50px;
}

.stat-container {
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 20, 20, 0.7);
    padding: 5px 15px;
    margin-bottom: 10px;
    rotate: -5deg;
    border-left-width: 5px;
}

.hp-bar { border-left-color: #4CAF50; }
.stamina-bar { border-left-color: #FF69B4; margin-left: 10px; }

.stat-text {
    color: white; /* Цифры теперь всегда белые */
    font-size: 28px;
    -unity-font-style: bold;
    width: 60px;
    margin-right: 10px;
}

.segments-row {
    flex-direction: row;
}

/* Настройки самих сегментов */
/* Основной вид сегмента теперь по умолчанию "выключенный" */
.segment {
    width: 18px;
    height: 38px;
    margin-right: 5px;
    /* Цвет пустой ячейки: очень слабый белый/серый */
    background-color: rgba(255, 255, 255, 0.07); 
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

/* Мы больше не используем DisplayStyle.None в коде, 
   поэтому сегменты всегда будут в ряд. */