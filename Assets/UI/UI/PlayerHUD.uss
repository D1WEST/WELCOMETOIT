.hud-root {
    position: absolute;
    bottom: 50px;
    left: 50px;
}

.stat-container {
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 20, 20, 0.7);
    padding: 5px 15px;
    margin-bottom: 10px;
    rotate: -5deg;
    border-left-width: 5px;
}

.hp-bar { border-left-color: #4CAF50; }
.stamina-bar { border-left-color: #FF69B4; margin-left: 10px; }

.stat-text {
    color: white; /* Цифры теперь всегда белые */
    font-size: 28px;
    -unity-font-style: bold;
    width: 60px;
    margin-right: 10px;
}

.segments-row {
    flex-direction: row;
}

/* Настройки самих сегментов */
/* Основной вид сегмента теперь по умолчанию "выключенный" */
.segment {
    width: 18px;
    height: 38px;
    margin-right: 5px;
    /* Цвет пустой ячейки: очень слабый белый/серый */
    background-color: rgba(255, 255, 255, 0.07); 
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

.crosshair {
    position: absolute;
    /* Центрирование */
    top: 50%;
    left: 50%;
    /* Размер точки */
    width: 6px;
    height: 6px;
    /* Цвет и форма */
    background-color: white;
    border-radius: 25px; /* Делает квадрат кругом */
    /* Смещение на собственную половину для идеального центра */
    translate: -50% -50%;
    
    /* Необязательно: тонкая обводка, чтобы точку было видно на светлом фоне */
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.5);
}

.boss-message-box {
    position: absolute;
    bottom: 120px;
    align-self: center;
    background-color: rgba(20, 20, 20, 0.95);
    border-width: 2px;
    border-color: white;
    border-radius: 10px;
    padding: 15px 25px;
    min-width: 450px;
    max-width: 800px;
    display: none; /* Скрыто по умолчанию */
}

.boss-label-header {
    color: #FFD700; /* Золотой цвет для имени */
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.boss-text {
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    white-space: normal; /* Разрешить перенос строк */
}

/* Мы больше не используем DisplayStyle.None в коде, 
   поэтому сегменты всегда будут в ряд. */