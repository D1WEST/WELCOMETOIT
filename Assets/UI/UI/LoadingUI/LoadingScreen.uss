.loading-container {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: #000000;
    display: none; /* <--- ОБЯЗАТЕЛЬНО ЭТА СТРОКА */
    justify-content: center;
    align-items: center;
}

.loading-text {
    color: white;
    font-size: 24px;
    letter-spacing: 15px; /* Широкое расстояние между буквами */
    margin-bottom: 20px;
    -unity-font-style: bold;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.8); /* Свечение текста */
}

/* Контейнер, держащий рамку и боковые палочки */
.progress-block {
    flex-direction: row;
    align-items: center;
    width: 60%; /* Ширина бара относительно экрана */
    height: 30px;
}

/* Боковые палочки */
.deco-line {
    width: 4px;
    height: 20px;
    background-color: white;
}

/* Рамка прогресс-бара */
.bar-frame {
    flex-grow: 1;
    height: 100%;
    border-width: 2px;
    border-color: white;
    margin-left: 15px;
    margin-right: 15px;
    padding: 3px; /* Отступ внутри рамки до заливки */
    justify-content: center;
}

/* Внутренняя заливка */
.bar-fill {
    height: 100%;
    background-color: white;
    width: 0%; /* Скрипт будет менять это от 0% до 100% */
}