<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="overlay" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.8); justify-content: center; align-items: center;">
        
        <ui:VisualElement name="check-frame" style="width: 700px; height: 350px; background-color: white; border-radius: 15px; border-width: 5px; border-color: #59C2FF; padding: 30px;">
            
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                <ui:Label name="bank-name" text="A Bank of Overtask" style="color: #0088CC; -unity-font-style: bold; font-size: 30px;"/>
                <ui:Label name="check-number" text="1536" style="color: #0088CC; font-size: 24px;"/>
            </ui:VisualElement>

            <ui:VisualElement style="margin-top: 40px; border-bottom-width: 2px; border-color: #59C2FF; flex-direction: row; align-items: flex-end; padding-bottom: 5px;">
                <ui:Label text="Pay to the order of" name="label-pay-to" style="color: #59C2FF; font-size: 16px; width: 140px; margin-bottom: 2px;"/>
                <ui:Label text="Overtask" style="font-size: 28px; color: black; -unity-font-style: bold; flex-grow: 1;"/>
                
                <ui:VisualElement name="amount-box" style="border-width: 2px; border-color: #59C2FF; padding: 5px 15px; flex-direction: row; align-items: center; background-color: white; margin-bottom: 5px;">
                    <ui:Label name="currency-symbol" text="$" style="color: #59C2FF; font-size: 28px; margin-right: 10px;"/>
                    <ui:Label name="amount-text" text="150.00" style="color: black; font-size: 28px; -unity-font-style: bold;"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement style="margin-top: 60px; border-bottom-width: 2px; border-color: #59C2FF; flex-direction: row; align-items: flex-end; padding-bottom: 5px;">
                <ui:Label text="For" name="label-for" style="color: #59C2FF; font-size: 20px; margin-right: 15px; margin-bottom: 2px;"/>
                <ui:Label name="description-text" text="Playing Overtask!" style="font-size: 24px; color: black; flex-grow: 1;"/>
                
                <ui:Label text="The Boss" name="label-signature" style="color: #0088CC; -unity-font-style: italic; font-size: 24px; margin-bottom: 2px;"/>
            </ui:VisualElement>

        </ui:VisualElement>

        <ui:Button name="action-btn" text="Cash Out" style="margin-top: 30px; width: 450px; height: 70px; background-color: #0088FF; color: white; border-radius: 20px; font-size: 34px; -unity-font-style: bold;"/>
        
    </ui:VisualElement>
</ui:UXML>