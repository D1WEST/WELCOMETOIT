<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="overlay" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); justify-content: center; align-items: center;">
        
        <ui:VisualElement name="perk-shop-root" style="width: 500px; background-color: rgb(28, 28, 28); border-width: 2px; border-color: rgb(255, 255, 255); border-radius: 10px; padding: 20px;">
            
            <ui:Label text="УЛУЧШЕНИЯ НАЧАЛЬНИКА" style="color: white; -unity-font-style: bold; font-size: 24px; margin-bottom: 20px; -unity-text-align: middle-center; letter-spacing: 2px;" />
            
            <ui:VisualElement style="height: 2px; background-color: rgba(255, 255, 255, 0.2); margin-bottom: 15px;" />

            <ui:VisualElement name="perks-list" style="margin-bottom: 20px;" />

            <ui:VisualElement style="align-items: center; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.1); padding-top: 15px;">
                <ui:Button name="btn-close" text="ЗАКРЫТЬ МЕНЮ" style="width: 250px; height: 45px; background-color: rgb(180, 50, 50); color: white; -unity-font-style: bold; border-radius: 5px;" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>